# Postgres. En local : docker compose up -d (voir docker-compose.yml).
# En production : Neon pose POSTGRES_URL et POSTGRES_URL_NON_POOLING tout seul.
DATABASE_URL=postgres://bruno:bruno@localhost:5433/bruno

# --- Authentification (BRU-4) ---
# Identifiants OAuth créés dans la console Google Cloud, écran de consentement en mode
# « Interne » : Google ne laissera alors passer que les comptes du Workspace.
# URI de redirection à déclarer : http://localhost:3000/api/auth/callback
#                            et  https://<domaine-de-prod>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret de signature des sessions. À générer : openssl rand -base64 48
SESSION_SECRET=

# Le domaine Workspace autorisé. Tout le reste est refusé.
BRUNO_DOMAINE=thevibecompany.co

# Facultatif : l'Espace dans lequel atterrissent les connexions. À défaut, l'unique Espace.
# BRUNO_SPACE_ID=

# Dev seulement : GET /api/auth/dev ouvre une session pour le premier Membre, sans Google.
# Refusé en production quoi qu il arrive.
# BRUNO_DEV_LOGIN=1

# --- Enrichissement (BRU-9) ---
# Sans clé, les Captures gardent leur titre brut : c'est un état acceptable, rien ne casse.
ANTHROPIC_API_KEY=
# BRUNO_LLM_MODELE=claude-haiku-4-5-20251001

# Les notifications de Relance (push web). Générer une paire :
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La publique part dans le navigateur, c'est son rôle ; la privée ne sort jamais du serveur.
# Sans elles, Bruno n'envoie rien — il se contente du journal, comme avant.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bruno@thevibecompany.co

# Les Relances sur l'iPhone (APNs). La clé se crée une fois dans le compte Apple Developer
# (Certificates, Identifiers & Profiles → Keys → Apple Push Notifications service) et ne se
# télécharge qu'une fois. APNS_KEY reçoit le contenu du fichier .p8, lignes BEGIN/END comprises.
# Sans elles, l'app ne reçoit rien et le reste continue.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
# APNS_ENV=sandbox — seulement pour un build lancé depuis Xcode. TestFlight parle à la production.
